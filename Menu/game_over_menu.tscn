[ext_resource type="Script" path="res://Menu/game_over_menu.gd" id="1_script"]

[node name="GameOverMenu" type="CanvasLayer"]
layer = 100
script = ExtResource("1_script")

; ── Overlay scuro (visibile solo quando il pannello centrale è attivo) ──────

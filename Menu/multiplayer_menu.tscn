[gd_scene format=3 uid="uid://multiplayer_menu"]

[ext_resource type="Script" path="res://Menu/multiplayer_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://Assets/UI/global_theme.tres" id="2_theme"]

[node name="MultiplayerMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.05, 0.07, 0.12, 1)

[node name="MainMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 80

[node name="Card" type="PanelContainer" parent="MainMargin"]
custom_minimum_size = Vector2(450, 0)
layout_mode = 2
size_flags_horizontal = 0
size_flags_vertical = 4

[node name="CardMargin" type="MarginContainer" parent="MainMargin/Card"]
theme_override_constants/margin_left = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_top = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="MainMargin/Card/CardMargin"]
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="MainMargin/Card/CardMargin/VBox"]
text = "MULTIGIOCATORE"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="PlayerNameField" type="LineEdit" parent="MainMargin/Card/CardMargin/VBox"]
unique_name_in_owner = true
placeholder_text = "Il tuo nome (es. Soldato)"
custom_minimum_size = Vector2(0, 40)

[node name="TabContainer" type="TabContainer" parent="MainMargin/Card/CardMargin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 200)

[node name="Crea Lobby" type="VBoxContainer" parent="MainMargin/Card/CardMargin/VBox/TabContainer"]

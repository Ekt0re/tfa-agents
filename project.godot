; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="tfa-agents"
config/version="0.1.8"
run/main_scene="uid://deb727qfvrtx4"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=3
boot_splash/use_filter=false
boot_splash/image="uid://cqjfifbyfyhtm"
config/icon="res://icon.svg"

[autoload]

GameEvents="*res://Scripts/game_events.gd"
RampEvents="*res://Scripts/ramp_events.gd"
GlobalSettings="*res://Global.tscn"
MissionManager="*uid://yjcluspn5mm2"

[editor_plugins]

enabled=PackedStringArray("res://addons/shader-previewer/plugin.cfg", "res://addons/virtual_joystick_plus/plugin.cfg")

[global_group]

team_2="Gruppo dei nemici del player PVE"
item=""
team_1="Gruppo del player nel PVE"
powerup="Item PowerUp"

[gui]

theme/custom="res://Assets/UI/global_theme.tres"

[input]

